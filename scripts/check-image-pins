#!/usr/bin/env bash
# Every image reference in a committed render must appear in
# deploy/images.lock.
#
# P-61 calls the lock "every infrastructure pin, one place". A manifest
# carries its image inline, so without this check the lock would be a
# second copy that drifts silently — and the first sign of the drift
# would be a cluster pulling a version nobody recorded. This makes the
# lock the authority it is described as, without a template step that
# would make the committed render something other than what the source
# says.
set -euo pipefail

render_dir=deploy/kustomize/rendered
lock=deploy/images.lock

if [[ ! -d "$render_dir" ]]; then
  printf 'no rendered output at %s\n' "$render_dir" >&2
  exit 1
fi

# The lock's values, one per line, with the key stripped. Compared whole
# (grep -x) rather than as substrings: an unanchored match would accept a
# tag-only render against a lock entry that has since gained a digest,
# which is exactly the drift this check exists to make impossible.
lock_values=$(sed -n 's/^[A-Z0-9_]*=//p' "$lock")

unpinned=0
while read -r reference; do
  [[ -n "$reference" ]] || continue
  if ! printf '%s\n' "$lock_values" | grep -qxF -- "$reference"; then
    printf 'rendered image is absent from %s: %s\n' "$lock" "$reference" >&2
    unpinned=1
  fi
done < <(
  grep -rhoE '^[[:space:]]*image:[[:space:]]*[^[:space:]]+' "$render_dir" |
    awk '{print $2}' | sort -u
)

exit "$unpinned"
