#!/usr/bin/env bash
# Generate a private CA and a Garden HTTPS certificate for one DNS name.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: generate-garden-tls DNS_NAME OUTPUT_DIRECTORY

Generate a private certificate authority and a Garden server certificate.
The DNS name must be the hostname in Garden's public HTTPS endpoint. Existing
key, certificate or configuration files are never overwritten.

Example:
  scripts/generate-garden-tls reference.example.net /home/cairn/garden-tls

Created files:
  internal-ca-key.pem   Private CA key; keep offline after certificate issuance
  internal-ca.pem       CA certificate distributed to Garden clients
  garden-key.pem        Garden server private key, mode 0600
  garden-cert.pem       Garden server certificate
  garden-chain.pem      Server certificate followed by the CA certificate
  garden.json           Complete Garden configuration; review scope and expiry

Example garden.json:
{
  "endpoint": "https://reference.example.net:8443/mcp",
  "port": 8443,
  "tls_cert_file": "/home/cairn/garden-tls/garden-chain.pem",
  "tls_key_file": "/home/cairn/garden-tls/garden-key.pem",
  "tls_ca_file": "/home/cairn/garden-tls/internal-ca.pem",
  "scope": {
    "realm": "local",
    "segments": [
      {
        "kind": "garden",
        "identifier": "engineering"
      }
    ]
  },
  "classification": "internal",
  "participants": {
    "spike": "claude",
    "val": "codex"
  },
  "expires_at": "2030-09-01T00:00:00Z"
}
EOF
}

if (( $# == 0 )) || [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
if (( $# != 2 )); then
  usage >&2
  exit 2
fi

dns_name=$1
output_dir=$2
if (( ${#dns_name} > 253 )); then
  printf 'DNS_NAME is invalid: %s\n' "$dns_name" >&2
  exit 2
fi
IFS='.' read -r -a dns_labels <<<"$dns_name"
for label in "${dns_labels[@]}"; do
  if (( ${#label} == 0 || ${#label} > 63 )) || \
    [[ ! $label =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]]; then
    printf 'DNS_NAME is invalid: %s\n' "$dns_name" >&2
    exit 2
  fi
done
if [[ -L $output_dir ]]; then
  printf 'OUTPUT_DIRECTORY must not be a symbolic link: %s\n' "$output_dir" >&2
  exit 2
fi
for command in openssl mktemp install python3; do
  command -v "$command" >/dev/null || {
    printf 'Required command is missing: %s\n' "$command" >&2
    exit 1
  }
done
if python3 - "$dns_name" >/dev/null 2>&1 <<'PY'
import ipaddress
import sys

ipaddress.ip_address(sys.argv[1])
PY
then
  printf 'DNS_NAME is invalid: %s\n' "$dns_name" >&2
  exit 2
fi

umask 077
install -d -m 0700 "$output_dir"
output_dir=$(cd "$output_dir" && pwd -P)

files=(
  internal-ca-key.pem
  internal-ca.pem
  garden-key.pem
  garden-cert.pem
  garden-chain.pem
  garden.json
)
for file in "${files[@]}"; do
  if [[ -e $output_dir/$file || -L $output_dir/$file ]]; then
    printf 'Refusing to overwrite %s\n' "$output_dir/$file" >&2
    exit 1
  fi
done

staging_dir=$(mktemp -d "$output_dir/.generate-garden-tls.XXXXXX")
extensions=$staging_dir/extensions.cnf
request=$staging_dir/garden.csr
cleanup() {
  rm -rf -- "$staging_dir"
}
trap cleanup EXIT

cat >"$extensions" <<EOF
[garden_server]
basicConstraints = critical, CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = DNS:${dns_name}
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
EOF

openssl req -x509 -newkey rsa:3072 -sha256 -nodes \
  -days 3650 \
  -keyout "$staging_dir/internal-ca-key.pem" \
  -out "$staging_dir/internal-ca.pem" \
  -subj '/CN=Cairn Garden Internal CA' \
  -addext 'basicConstraints=critical,CA:TRUE' \
  -addext 'keyUsage=critical,keyCertSign,cRLSign' \
  -addext 'subjectKeyIdentifier=hash'

openssl req -new -newkey rsa:3072 -sha256 -nodes \
  -keyout "$staging_dir/garden-key.pem" \
  -out "$request" \
  -subj "/CN=${dns_name}"

openssl x509 -req -sha256 \
  -in "$request" \
  -CA "$staging_dir/internal-ca.pem" \
  -CAkey "$staging_dir/internal-ca-key.pem" \
  -set_serial "0x$(openssl rand -hex 16)" \
  -days 825 \
  -extfile "$extensions" \
  -extensions garden_server \
  -out "$staging_dir/garden-cert.pem"

cat "$staging_dir/garden-cert.pem" "$staging_dir/internal-ca.pem" \
  >"$staging_dir/garden-chain.pem"
chmod 0600 "$staging_dir/internal-ca-key.pem" "$staging_dir/garden-key.pem"
chmod 0644 \
  "$staging_dir/internal-ca.pem" \
  "$staging_dir/garden-cert.pem" \
  "$staging_dir/garden-chain.pem"

openssl verify \
  -CAfile "$staging_dir/internal-ca.pem" \
  "$staging_dir/garden-cert.pem" >/dev/null
openssl x509 \
  -in "$staging_dir/garden-cert.pem" \
  -checkhost "$dns_name" \
  -noout >/dev/null

python3 - "$dns_name" "$output_dir" "$staging_dir/garden.json" <<'PY'
from datetime import UTC, datetime, timedelta
import json
from pathlib import Path
import sys

dns_name, output_dir, config_file = sys.argv[1:]
expires_at = (datetime.now(UTC) + timedelta(days=365)).replace(microsecond=0)
Path(config_file).write_text(
    json.dumps(
        {
            "endpoint": f"https://{dns_name}:8443/mcp",
            "port": 8443,
            "tls_cert_file": f"{output_dir}/garden-chain.pem",
            "tls_key_file": f"{output_dir}/garden-key.pem",
            "tls_ca_file": f"{output_dir}/internal-ca.pem",
            "scope": {
                "realm": "local",
                "segments": [{"kind": "garden", "identifier": "engineering"}],
            },
            "classification": "internal",
            "participants": {"spike": "claude", "val": "codex"},
            "expires_at": expires_at.isoformat().replace("+00:00", "Z"),
        },
        indent=2,
    ) + "\n"
)
PY

for file in "${files[@]}"; do
  mv -- "$staging_dir/$file" "$output_dir/$file"
done

printf 'Garden TLS material created and verified in %s\n\n' "$output_dir"
printf 'Saved complete configuration to %s/garden.json; review scope, participants, port and expiry before installation.\n' "$output_dir"
printf 'Garden configuration:\n'
cat "$output_dir/garden.json"
