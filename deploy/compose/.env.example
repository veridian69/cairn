# One instance's parameters. Copy to `.env`, edit, and keep it out of
# Git — `.gitignore` already ignores it.
#
# This file carries no image pin, deliberately. The Cairn and FalkorDB
# images are pinned once in `../images.lock`, which reaches Compose as a
# second `--env-file`; a value here would shadow that pin, which is
# precisely the drift the arrangement exists to prevent.

# The instance name, and the whole of what separates two instances on one
# host: Compose prefixes this project's network and volumes with it.
COMPOSE_PROJECT_NAME=cairn-a

# The loopback port this instance is published on. The address is not a
# parameter — see the comment on `ports` in compose.yaml.
CAIRN_HOST_PORT=8080

# The instance's `cairn.config/v1` document, bind-mounted read-only at
# /etc/cairn/config.yaml. Copy `config.example.yaml` and give it a real
# `instance_id`; the placeholder in it is not a valid UUID, so forgetting
# fails configuration loading rather than passing silently (I-41).
CAIRN_CONFIG_FILE=./config.yaml

# The I-92 adapter-credential directory, bind-mounted read-only at
# /var/run/secrets/cairn. With retrieval disabled nothing in it is read;
# with retrieval enabled it holds `falkordb-password` and
# `openai-api-key`, and optionally `falkordb-username`.
CAIRN_CREDENTIALS_DIR=./credentials

# The index's configuration file, needed only by the
# `compose.graphiti.yaml` composition and bind-mounted read-only. It
# carries the index's `requirepass` line, which is the only place that
# credential exists in this project: no password is set here, in the
# service environment, or on any command line. README.md generates the
# file and Cairn's copy of the same secret in one step.
#
# Left unset rather than given a placeholder — an unset value refuses the
# composition, and a missing file refuses it too.
#
# FALKORDB_CONFIG_FILE=./falkordb.conf
