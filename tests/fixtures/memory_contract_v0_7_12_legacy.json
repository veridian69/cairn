      "additionalProperties": false,
      "properties": {
        "budget": {
          "default": 16384,
          "description": "UTF-8 byte budget (1\u20131048576) for the sum of canonical JSON disclosed records, including attribution, reasons and relationships. Envelope punctuation is excluded. Facts are admitted before bounded relationship context; per-fact flags identify visible disagreement and omitted context.",
          "maximum": 1048576,
          "minimum": 1,
          "title": "Budget",
          "type": "integer"
        },
        "fact_id": {
