    "FailureBody": {
      "additionalProperties": false,
      "description": "The I-26 stable failure on the wire.\n\nField order matches the foundation middleware's ``internal_error``\nbody, so a ``/v1`` failure and the middleware's catch-all are the same\nshape; ``detail`` is absent unless one of the two licensed forms rides\nalong.",
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "authentication_failed",
            "authorisation_denied",
            "secret_rejected",
            "not_found",
            "idempotency_conflict",
            "evidence_pending",
            "evidence_corrupt",
            "index_pending",
            "stale_index",
            "dependency_unavailable",
            "instance_mismatch",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/InvalidRequestDetail"
            },
            {
              "$ref": "#/components/schemas/SecretRejectedDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retry": {
          "enum": [
            "never",
            "same-request",
            "after-delay"
          ],
          "title": "Retry",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "retry",
        "correlation_id"
      ],
      "title": "FailureBody",
      "type": "object"
    },
    "FailureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "$ref": "#/components/schemas/FailureBody"
        }
      },
      "required": [
        "failure"
      ],
      "title": "FailureEnvelope",
      "type": "object"
    },
