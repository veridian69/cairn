#!/usr/bin/env bash
# Build on native Linux; runtime acceptance is a separate Windows step.
set -euo pipefail
relay_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
repo_dir=$(cd -- "$relay_dir/.." && pwd -P)
case "$repo_dir" in /mnt/*) printf 'Build from a native Linux checkout.\n' >&2; exit 1 ;; esac
output_dir="$repo_dir/build/cairn-mcp/windows-amd64"
mkdir -p "$output_dir"
cd "$relay_dir"
CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -o "$output_dir/cairn-mcp.exe" ./cmd/cairn-mcp
CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go test -c -trimpath -o "$output_dir/credentials.test.exe" ./internal/credentials
CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go test -c -trimpath -o "$output_dir/stdio.test.exe" ./cmd/cairn-mcp
sys_dir=$(go list -m -f '{{.Dir}}' golang.org/x/sys)
install -m 0644 "$sys_dir/LICENSE" "$output_dir/LICENSE-golang-x-sys.txt"
cp "$repo_dir/LICENSE.md" "$repo_dir/LICENSE-Apache-2.0.txt" "$repo_dir/NOTICE.md" "$output_dir/"
cp WINDOWS.md "$output_dir/README.md"
cp scripts/setup-windows.ps1 scripts/test-windows.ps1 scripts/test-setup-windows.ps1 "$output_dir/"
python3 - "$repo_dir" "$output_dir" <<'PY'
import hashlib, json, subprocess, sys, zipfile
from pathlib import Path
repo, out = map(Path, sys.argv[1:])
relay = repo / 'cairn-mcp'
source_paths = sorted(p for p in relay.rglob('*') if p.is_file() and
                      (p.suffix == '.go' or p.name in {'go.mod', 'go.sum', 'WINDOWS.md',
                       'setup-windows.ps1', 'test-windows.ps1', 'test-setup-windows.ps1', 'build-windows'}))
sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
info = {
    'base_revision': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo, text=True).strip(),
    'uncommitted_changes': bool(subprocess.check_output(['git', 'status', '--porcelain', '--', 'cairn-mcp'], cwd=repo)),
    'go': subprocess.check_output(['go', 'version'], text=True).strip(),
    'target': 'windows/amd64', 'cgo': False,
    'validation': 'Build only; run the included Windows scripts for runtime evidence.',
    'source_sha256': {str(p.relative_to(repo)): sha(p) for p in source_paths},
}
(out / 'BUILD-INFO.json').write_text(json.dumps(info, indent=2) + '\n')
names = ['BUILD-INFO.json', 'LICENSE-Apache-2.0.txt', 'LICENSE-golang-x-sys.txt',
         'LICENSE.md', 'NOTICE.md', 'README.md', 'cairn-mcp.exe', 'credentials.test.exe',
         'stdio.test.exe', 'setup-windows.ps1', 'test-windows.ps1', 'test-setup-windows.ps1']
(out / 'SHA256SUMS').write_text(''.join(f'{sha(out / n)}  {n}\n' for n in sorted(names)))
archive = out.parent / 'cairn-mcp-windows-amd64.zip'
with zipfile.ZipFile(archive, 'w', compression=zipfile.ZIP_DEFLATED) as z:
    for name in sorted(names + ['SHA256SUMS']):
        entry = zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0))
        entry.compress_type = zipfile.ZIP_DEFLATED
        entry.external_attr = 0o100644 << 16
        z.writestr(entry, (out / name).read_bytes())
print(archive)
print('SHA256', sha(archive))
PY
